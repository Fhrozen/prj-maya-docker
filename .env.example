# Project Maya container settings. Copy to .env and edit: cp .env.example .env
# Every name here is read by the container (docker/entrypoint.sh or docker/prepare.py),
# or by docker-compose.yaml itself. Empty means "use the default", so leaving a line
# blank is fine.

# ---- compose ----
# image to run (what build.sh built)
MAYA_IMAGE=project-maya:1.1.49-cuda12
# where the port is published on the host. Keep it on loopback; the API key is the only
# thing between this service and anyone who can reach the port.
MAYA_BIND=127.0.0.1
MAYA_PORT=8080
# run as this uid:gid (empty: the image's own user, 1000:1000). A named volume is created
# with the ownership baked into the image, so if you set your own uid here, chown the
# volume once or mount a bind mount.
MAYA_USER=
# /data as a named volume (empty: maya-data) or as a host folder, e.g. MAYA_DATA=/srv/maya
# A bind mount keeps the host's ownership, so that folder must be owned by the uid the
# container runs as.
MAYA_DATA=

# ---- the model ----
# a GLM-5.3-Flash quant: Maya-S-v2-IQ2_XXS, Maya-S24, Maya-M3, ... Empty: what maya.py
# recommends for the card the container sees. Only the GLM family can be prepared inside
# the container (the other families' setup needs the CUDA toolkit, which the runtime image
# does not have).
MODEL=Maya-S-v2-IQ2_XXS
# model files you already have, as seen inside the container (a folder, or the first .gguf
# in it). The pack is written next to them, so this must be writable.
MODEL_PATH=
# where downloads go
MODELS_DIR=/data/models
# 1: download what is missing. 0: stop instead of downloading.
DOWNLOAD=1
# 1: rebuild the pack even if one exists.
REPACK=0
CONTEXT=32768
PARALLEL=
VISION=on
DRAFT=mtp
VRESERVE=

# ---- the server ----
HOST=0.0.0.0
PORT=8080
# the key clients must send. The server does not serve beyond loopback without a key, so
# one is always on: this one, or one made on the first start and kept in /data/state/api-key.
API_KEY=change-me-please-1234567890
# Hugging Face read token, for a gated repo
HF_TOKEN=

# ---- the GPU ----
# card numbers the container may use, e.g. 0 or 0,1. Empty or all: the engine's choice.
GPUS=

# ---- advanced ----
# engine settings written into the config, space separated KEY=VALUE (like maya.py --env)
MAYA_ENV=
